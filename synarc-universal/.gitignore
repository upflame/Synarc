# ===================================
# Synarc Universal — Package .gitignore
# ===================================

# --- Local development ---
.cache/
.stripped/
node_modules/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS artifacts ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Editor / IDE scratch ---
.vscode/
.idea/
*.swp
*.swo
*.bak
*~

# --- Test artifacts ---
test-results/
junit.xml
lcov.info
coverage/
.nyc_output/

# --- Build / Pack ---
*.tgz

# --- Synarc runtime (generated per-session) ---
brain/
synarc.lock.json
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://synarc.dev/schemas/risk-assessment-v1.json",
  "title": "Risk Assessment",
  "description": "Deterministic risk assessment output for a change",
  "type": "object",
  "required": [
    "change_id",
    "work_type",
    "risk_level",
    "risk_score",
    "dimensions"
  ],
  "properties": {
    "change_id": {
      "type": "string",
      "description": "Unique identifier for the assessed change"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Assessment timestamp"
    },
    "work_type": {
      "type": "string",
      "enum": [
        "FEATURE", "FIX", "REFACTOR", "SCHEMA", "CONTRACT",
        "CONFIG", "INFRA", "EXPERIMENT", "DOCS", "ANALYSIS",
        "PLAN", "INCIDENT"
      ],
      "description": "Work type of the assessed change"
    },
    "risk_level": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"],
      "description": "Composite risk level"
    },
    "risk_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "Numeric risk score"
    },
    "dimensions": {
      "type": "object",
      "required": [
        "breadth",
        "reversibility",
        "scope_alignment",
        "urgency",
        "confidence"
      ],
      "properties": {
        "breadth": {
          "type": "string",
          "enum": ["SINGLE_FILE", "MULTI_FILE", "CROSS_SERVICE", "CROSS_BOUNDARY"],
          "description": "Impact radius of the change"
        },
        "reversibility": {
          "type": "string",
          "enum": ["REVERTIBLE", "PARTIAL", "IRREVERSIBLE"],
          "description": "Rollback difficulty"
        },
        "scope_alignment": {
          "type": "string",
          "enum": ["IN_SCOPE", "PLANNED", "UNPLANNED", "SCOPE_CREEP"],
          "description": "How change relates to declared scope"
        },
        "urgency": {
          "type": "string",
          "enum": ["NORMAL", "HIGH", "BLOCKING", "EMERGENCY"],
          "description": "Timeline pressure"
        },
        "confidence": {
          "type": "string",
          "enum": ["CERTAIN", "LIKELY", "UNCERTAIN", "CONTRADICTED"],
          "description": "Certainty of this assessment"
        }
      }
    },
    "domain": {
      "type": "string",
      "description": "Affected domain (e.g., auth, payment, schema)"
    },
    "domain_floor": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"],
      "description": "Hard risk floor for this domain (cannot be lowered)"
    },
    "composite_rules_applied": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Composite risk rules that affected this assessment"
    },
    "escalation_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "Current escalation level (0=normal, 5=full stop)"
    },
    "rollback_plan": {
      "type": "string",
      "description": "Suggested rollback strategy"
    }
  }
}

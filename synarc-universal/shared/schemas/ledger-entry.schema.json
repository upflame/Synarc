{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://synarc.dev/schemas/ledger-entry-v1.json",
  "title": "Session Ledger Entry",
  "description": "Immutable entry in the session change ledger",
  "type": "object",
  "required": [
    "timestamp",
    "work_type",
    "risk",
    "files_changed",
    "session_id"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the change"
    },
    "session_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique session identifier"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^CTR-[A-Z0-9]{8}$",
      "description": "Intent Contract ID this ledger entry belongs to"
    },
    "work_type": {
      "type": "object",
      "required": ["primary", "sub_type"],
      "properties": {
        "primary": {
          "type": "string",
          "enum": [
            "FEATURE",
            "FIX",
            "REFACTOR",
            "SCHEMA",
            "CONTRACT",
            "CONFIG",
            "INFRA",
            "EXPERIMENT",
            "DOCS",
            "ANALYSIS",
            "PLAN",
            "INCIDENT"
          ],
          "description": "Primary work type classification"
        },
        "sub_type": {
          "type": "string",
          "description": "Work type sub-classification"
        }
      }
    },
    "risk": {
      "type": "object",
      "required": ["level", "score"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"],
          "description": "Risk level"
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "Numeric risk score (0=INFO, 5=BLOCKING)"
        }
      }
    },
    "scope_alignment": {
      "type": "string",
      "enum": ["IN_SCOPE", "PLANNED", "UNPLANNED", "SCOPE_CREEP"],
      "description": "How this change relates to declared scope"
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "change_type"],
        "properties": {
          "path": {
            "type": "string",
            "description": "File path relative to project root"
          },
          "change_type": {
            "type": "string",
            "enum": ["ADD", "MODIFY", "DELETE", "RENAME", "MOVE"],
            "description": "Type of file change"
          },
          "additions": {
            "type": "integer",
            "minimum": 0,
            "description": "Lines added"
          },
          "deletions": {
            "type": "integer",
            "minimum": 0,
            "description": "Lines deleted"
          }
        }
      },
      "minItems": 1
    },
    "contracts_affected": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "API contracts or interfaces affected by this change"
    },
    "breaking_change": {
      "type": "boolean",
      "default": false,
      "description": "Whether this change introduces a breaking change"
    },
    "rollback_plan": {
      "type": "string",
      "description": "Rollback strategy if available"
    },
    "classification_confidence": {
      "type": "string",
      "enum": ["CERTAIN", "LIKELY", "UNCERTAIN", "CONTRADICTED"],
      "description": "Confidence in the classification"
    }
  }
}

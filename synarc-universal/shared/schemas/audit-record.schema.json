{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://synarc.dev/schemas/audit-record-v1.json",
  "title": "Audit Record",
  "description": "Immutable audit record for compliance — captures the full intent-to-execution-to-verification chain",
  "type": "object",
  "required": [
    "audit_id",
    "session_id",
    "contract_id",
    "work_type",
    "intent_statement",
    "scope_declared",
    "scope_actual",
    "risk_cap",
    "risk_actual",
    "verdict",
    "timeline"
  ],
  "properties": {
    "audit_id": {
      "type": "string",
      "pattern": "^AUD-[A-Z0-9]{10}$",
      "description": "Unique audit record identifier"
    },
    "session_id": {
      "type": "string",
      "description": "Session ID this audit belongs to"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^CTR-[A-Z0-9]{8}$",
      "description": "Intent Contract ID"
    },
    "work_type": {
      "type": "object",
      "required": ["primary", "sub_type"],
      "properties": {
        "primary": {
          "type": "string",
          "enum": ["FEATURE","FIX","REFACTOR","SCHEMA","CONTRACT","CONFIG","INFRA","EXPERIMENT","DOCS","ANALYSIS","PLAN","INCIDENT"]
        },
        "sub_type": { "type": "string" }
      }
    },
    "intent_statement": {
      "type": "string",
      "description": "Original user request/intent in natural language"
    },
    "template_used": {
      "type": "string",
      "pattern": "^TMPL-",
      "description": "Template ID if a template was used"
    },
    "scope_declared": {
      "type": "object",
      "properties": {
        "files": { "type": "array", "items": { "type": "string" } },
        "modules": { "type": "array", "items": { "type": "string" } },
        "contract_changes_allowed": { "type": "boolean" },
        "schema_changes_allowed": { "type": "boolean" },
        "destructive_ops_allowed": { "type": "boolean" }
      }
    },
    "scope_actual": {
      "type": "object",
      "properties": {
        "files_changed": { "type": "array", "items": { "type": "string" } },
        "scope_violations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "promises": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "verification_method": { "type": "string" },
          "status": { "type": "string", "enum": ["kept","broken","skipped"] }
        }
      }
    },
    "risk_cap": {
      "type": "string",
      "enum": ["INFO","LOW","MEDIUM","HIGH","CRITICAL"]
    },
    "risk_actual": {
      "type": "string",
      "enum": ["INFO","LOW","MEDIUM","HIGH","CRITICAL"]
    },
    "risk_delta": {
      "type": "string",
      "enum": ["NONE","ESCALATED","DE_ESCALATED"]
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS","WARN","BREACH","FAIL"]
    },
    "timeline": {
      "type": "object",
      "required": ["classified_at", "contracted_at", "executed_at", "verified_at"],
      "properties": {
        "classified_at": { "type": "string", "format": "date-time" },
        "contracted_at": { "type": "string", "format": "date-time" },
        "executed_at": { "type": "string", "format": "date-time" },
        "verified_at": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "integer", "description": "Total execution time in milliseconds" }
      }
    },
    "governance_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "event_type", "description"],
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "event_type": {
            "type": "string",
            "enum": ["CONTRACT_AMENDED", "SCOPE_VIOLATION", "RISK_BREACH", "USER_OVERRIDE", "ROLLBACK", "VERDICT_ISSUED"]
          },
          "description": { "type": "string" },
          "actor": { "type": "string", "description": "User or system that triggered the event" }
        }
      }
    },
    "compliance_tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Compliance frameworks this audit applies to (e.g., EU_AI_ACT, SOC2, HIPAA)"
    },
    "exportable": {
      "type": "boolean",
      "default": true,
      "description": "Whether this record can be exported for compliance reporting"
    }
  }
}

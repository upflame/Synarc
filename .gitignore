# ========================
# Synarc — Root .gitignore
# ========================

# --- Environment ---
.env
.env.*
!.env.example

# --- Dependencies ---
node_modules/
package-lock.json

# --- OS artifacts ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
ehthumbs_vista.db
*.lnk

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo
*.bak
*~

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Build / Pack ---
*.tgz
dist/

# --- Runtime / Cache ---
.cache/
.stripped/
.nyc_output/
coverage/

# --- Test artifacts ---
test-results/
junit.xml
lcov.info

# --- Synarc runtime (generated per-session) ---
brain/
